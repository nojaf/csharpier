public partial class Match : Node2D
{
    [Export]
    private Tide? ExportTide { get; set; }

    private Tide Tide => Wired(ExportTide);
    private int count = Initial();

    private static int Initial() => 0;

    private static Exception Unset(Type type) => new InvalidOperationException(type.Name);

    private static T Wired<T>(T? export)
        where T : class
    {
        return export ?? throw Unset(typeof(T));
    }

    public override void _Ready()
    {
        Tide.Initialize();
    }

    private void Unrelated() { }
}
